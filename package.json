{
  "name": "emploi-go-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <25",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:all": "node scripts/dev.ts all",
    "dev:frontend": "node scripts/dev.ts frontend",
    "test": "node scripts/check.ts test",
    "test:e2e": "node scripts/e2e.ts",
    "check": "node scripts/check.ts",
    "format": "prettier --write .",
    "lint": "npm run lint -w frontend",
    "typecheck": "tsc -p tsconfig.scripts.json && npm run typecheck -w frontend",
    "build": "npm run build -w frontend",
    "api:sync": "node scripts/api.ts sync",
    "api:generate": "node scripts/api.ts generate",
    "services:up": "node scripts/services.ts up",
    "services:down": "node scripts/services.ts down",
    "services:reset": "node scripts/services.ts reset"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "typescript": "5.9.3"
  }
}

# Configuration locale Compose, jamais des identifiants de production.
DB_PASSWORD=local-development-only
REDIS_PASSWORD=local-development-only
# Ports locaux de PostgreSQL et Redis ; sans valeur, 5432 et 6379, ou un port libre s'ils sont pris.
# DB_PORT=5432
# REDIS_PORT=6379
# Compte fictif opt-in, uniquement dans le profil local (20 à 128 caractères).
DEV_AUTH_ACCOUNT=false
# DEV_AUTH_PASSWORD=
# Hors proxy, ne jamais faire confiance aux en-têtes transférés.
FORWARD_HEADERS_STRATEGY=NONE
# En déploiement derrière un proxy : NATIVE, avec uniquement son adresse exacte.
TRUSTED_PROXY_PATTERN=127\.0\.0\.1|::1

# Dossier des photos des établissements, servies par l'API.
# ESTABLISHMENT_IMAGES_DIRECTORY=/var/lib/emploi-go/establishment-images

# Inscription et récupération : envoi direct par l'API, aucun worker nécessaire.
REGISTRATION_MAIL_MODE=disabled
REGISTRATION_MAIL_FROM=onboarding@resend.dev
PUBLIC_APP_ORIGIN=http://localhost:5173
# RESEND_API_KEY=
# Base64 de 32 à 64 octets aléatoires, stable ; dérivations distinctes confirmation/récupération.
# CONFIRMATION_TOKEN_KEY=

# Clé des compteurs de quota dans Redis : Base64 de 32 à 64 octets aléatoires, stable. Obligatoire hors du profil local.
# QUOTA_KEY=
# Import des établissements : clé de l'API Sirene de l'INSEE, à créer sur portail-api.insee.fr (jamais dans Git). Sans elle, le worker démarre et l'import échoue.
# SIRENE_API_KEY=

# Mode local seulement (profils local/test) : npm run dev démarre sa boîte et donne son adresse à l'API.
# Une autre valeur envoie à cette adresse, sans démarrer de boîte.
# LOCAL_MAIL_URL=http://127.0.0.1:8025/emails

# Client OAuth Google de type Web ; secrets exclusivement côté API.
GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback/google

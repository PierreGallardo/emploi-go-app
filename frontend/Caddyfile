{
	admin off
	auto_https off
	grace_period 5s
	servers {
		# The proxy of the server, in front, sets X-Forwarded-For; any other source cannot change the visitor address.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		protocols h1
	}
}

:8080 {
	header -Server

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	root * /srv
	encode zstd gzip
	# Spring Security sets the headers of the API responses.
	@static not path /api /api/*
	header @static {
		# Generated by the build: the hashes of the inline scripts of every HTML page.
		import csp.caddyfile
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	}

	@versioned path /assets/* /cartes/*
	handle @versioned {
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206
		}
		file_server
	}

	# A missing file must get a 404, never the HTML of the application.
	@file file
	@missingFile path_regexp \.[^/]*$
	handle @file {
		header Cache-Control no-cache
		file_server
	}
	handle @missingFile {
		error 404
	}
	# A prerendered route gets its own page; any other route gets the SPA fallback, which React Router writes to index.html.
	handle {
		header Cache-Control no-cache
		try_files {path}/index.html /index.html
		file_server
	}

	handle_errors {
		header -Server
	}
}
